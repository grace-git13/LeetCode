// Palindrome: Check if the reverse of an integer is equal to the original number without using string functions.
// Completed 1st November 2026

class Solution {
    public boolean isPalindrome(int x) {
        int temp = x;
        int rev = 0;
        while(temp>0)
		{
		    rev += temp%10;
		    rev = (temp>=10)? rev*10 : rev;
		    temp /= 10;
		}
        if(rev==x)
            return true;
        else
            return false;
    }
}
