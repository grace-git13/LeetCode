// Two Sum: Program to find the indices of two elements that add up to a target.
// Completed on 1st November 2026

class Solution {
    public int[] twoSum(int[] nums, int target) {
        int[] k = new int[2];
        for(int i=0; i<nums.length; i++)
            for(int j=0; j<nums.length; j++)
                if(i!=j)
                    if(nums[i]+nums[j]==target)
                    {
                        k[0] = i;
                        k[1] = j;
                        break;
                    }
        return k;
    }
}
